# Required — get from Neon console
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Required — min 32 chars, generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-minimum-32-characters-here

# Optional
JWT_EXPIRES_IN=24h
PORT=3000
NODE_ENV=development

# Phase 2 — email (optional for Phase 1, required for Phase 2 invite/reset flows)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:5173
